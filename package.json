{
  "name": "@kokoro/billing",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "type": "module",
  "engines": {
    "node": "24.20.0"
  },
  "scripts": {
    "test": "pnpm prisma:generate && vitest run --no-file-parallelism",
    "typecheck": "pnpm prisma:generate && tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "build": "pnpm prisma:generate && tsc -p tsconfig.build.json",
    "contract:check": "tsx scripts/verify-openapi.ts",
    "sql:check": "tsx scripts/verify-sql-naming.ts",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm build && pnpm sql:check && pnpm contract:check && pnpm test",
    "db:apply-schema": "tsx scripts/apply-schema.ts",
    "db:verify-schema": "tsx scripts/verify-schema.ts",
    "prisma:refresh": "tsx scripts/prisma-refresh.ts",
    "prisma:generate": "PRISMA_DATABASE_URL=postgresql://localhost/offline prisma generate",
    "prisma:check": "tsx scripts/prisma-check.ts",
    "db:seed": "tsx scripts/seed-billing.ts",
    "internal:expire-credit-holds": "tsx scripts/expire-credit-holds.ts",
    "worker:payment-events": "tsx scripts/process-payment-events.ts",
    "worker:execution-events": "tsx scripts/process-execution-events.ts",
    "test:integration": "pnpm prisma:generate && vitest run test/integration --no-file-parallelism",
    "dev": "tsx src/main.ts",
    "start": "node dist/src/main.js",
    "format": "prettier --config .prettierrc.json --ignore-path .prettierignore --no-editorconfig --write \"{src,test,scripts}/**/*.{ts,mts,cts,tsx,js,mjs,cjs,json,yaml,yml}\" \"*.{ts,mts,cts,tsx,mjs,json,yaml,yml}\" \".github/**/*.{ts,mts,cts,tsx,js,mjs,cjs,json,yaml,yml}\" \".prettierrc.json\"",
    "format:check": "prettier --config .prettierrc.json --ignore-path .prettierignore --no-editorconfig --check \"{src,test,scripts}/**/*.{ts,mts,cts,tsx,js,mjs,cjs,json,yaml,yml}\" \"*.{ts,mts,cts,tsx,mjs,json,yaml,yml}\" \".github/**/*.{ts,mts,cts,tsx,js,mjs,cjs,json,yaml,yml}\" \".prettierrc.json\""
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.3",
    "@types/pg": "8.23.1",
    "eslint": "10.10.0",
    "prettier": "3.9.6",
    "prisma": "7.10.0",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0",
    "vite": "8.2.2",
    "vitest": "5.0.0",
    "yaml": "2.9.0"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "fastify": "5.12.1",
    "jose": "5.10.0",
    "pg": "8.23.0",
    "prom-client": "15.1.3",
    "redis": "5.12.1",
    "stripe": "22.6.1",
    "zod": "3.25.76"
  }
}
