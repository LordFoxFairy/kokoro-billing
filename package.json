{
  "name": "@kokoro/billing",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "test": "vitest run --no-file-parallelism",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "build": "tsc -p tsconfig.build.json",
    "contract:check": "tsx scripts/verify-openapi.ts",
    "sql:check": "tsx scripts/verify-sql-naming.ts",
    "verify": "pnpm lint && pnpm typecheck && pnpm build && pnpm sql:check && pnpm contract:check && pnpm test",
    "db:migrate": "tsx scripts/apply-migrations.ts",
    "db:seed": "tsx scripts/seed-billing.ts",
    "internal:expire-credit-holds": "tsx scripts/expire-credit-holds.ts",
    "worker:payment-events": "tsx scripts/process-payment-events.ts",
    "worker:execution-events": "tsx scripts/process-execution-events.ts",
    "test:integration": "vitest run test/integration --no-file-parallelism",
    "dev": "tsx src/main.ts",
    "start": "node dist/src/main.js"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.15.21",
    "@types/pg": "^8.23.1",
    "eslint": "^9.39.5",
    "tsx": "^4.19.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^2.1.9",
    "yaml": "^2.9.0"
  },
  "dependencies": {
    "fastify": "^5.6.2",
    "jose": "^5.10.0",
    "pg": "^8.23.0",
    "prom-client": "^15.1.3",
    "redis": "^5.8.2",
    "stripe": "^22.5.0",
    "zod": "^3.25.76"
  }
}
