  tenant_id        String   @db.VarChar(191)
  command_name     String   @db.VarChar(128)
  command_identity String?  @db.VarChar(255)
  idempotency_key  String   @db.VarChar(128)
  payload_hash     String   @db.Char(64)
  status           String   @default("processing") @db.VarChar(32)
  result_json      Json?
  created_at       DateTime @default(dbgenerated("CURRENT_TIMESTAMP(3)")) @db.Timestamptz(3)
  updated_at       DateTime @default(dbgenerated("CURRENT_TIMESTAMP(3)")) @db.Timestamptz(3)

  @@unique([tenant_id, command_name, command_identity], map: "uq_payment_command_receipt_identity", where: raw("(command_identity IS NOT NULL)"))
  @@unique([tenant_id, command_name, idempotency_key], map: "uq_payment_command_receipt_key")
}

model payment_customer_binding {
  binding_id            String   @id @db.VarChar(36)
  tenant_id             String   @db.VarChar(191)
  subject_id            String   @db.VarChar(255)
  provider_account_id   String   @db.VarChar(36)
  external_customer_ref String   @db.VarChar(255)
  created_at            DateTime @default(dbgenerated("CURRENT_TIMESTAMP(3)")) @db.Timestamptz(3)

  @@unique([provider_account_id, external_customer_ref], map: "uq_payment_customer_binding_external")
}

model payment_outbox {
  outbox_id        String    @id @db.VarChar(36)
  lease_token      String?   @db.VarChar(36)
  lease_until      DateTime? @db.Timestamptz(3)
  dead_lettered_at DateTime? @db.Timestamptz(3)
  tenant_id        String    @db.VarChar(191)
  aggregate_type   String    @db.VarChar(64)
  aggregate_id     String    @db.VarChar(36)
  event_type       String    @db.VarChar(128)
  payload_json     Json
  attempts         Int       @default(0)
  next_attempt_at  DateTime  @default(dbgenerated("CURRENT_TIMESTAMP(3)")) @db.Timestamptz(3)
  published_at     DateTime? @db.Timestamptz(3)
  created_at       DateTime  @default(dbgenerated("CURRENT_TIMESTAMP(3)")) @db.Timestamptz(3)

  @@unique([aggregate_type, aggregate_id, event_type], map: "uq_payment_outbox_source_event")
  @@index([next_attempt_at, created_at, outbox_id], map: "ix_payment_outbox_dispatch", where: raw("((published_at IS NULL) AND (dead_lettered_at IS NULL))"))
}

