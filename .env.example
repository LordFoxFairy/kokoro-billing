# Normal canonical Nest read graph; reuse the shared application database.
DATABASE_URL=postgresql://USER:SECRET@HOST/APP?schema=kokoro_billing
BILLING_AUTH_MODE=jwks
BILLING_AUTH_JWKS_URL=https://IAM_ORIGIN/iam/jwks
BILLING_AUTH_JWT_ISSUER=https://IAM_ORIGIN/iam
BILLING_AUTH_JWT_AUDIENCE=https://kokoro.dev/resources/billing
BILLING_HOST=127.0.0.1
BILLING_PORT=4245
BILLING_SHUTDOWN_DEADLINE_MS=10000
LOG_LEVEL=info
INTERNAL_SERVICE_SECRET=REPLACE_WITH_DISTINCT_32_PLUS_PRINTABLE_SECRET_A
BILLING_BFF_SERVICE_TOKEN=REPLACE_WITH_DISTINCT_32_PLUS_PRINTABLE_SECRET_B
BILLING_OPERATOR_PROXY_SECRET=REPLACE_WITH_DISTINCT_32_PLUS_PRINTABLE_SECRET_C
# No Redis, provider or payment credentials are consumed by this initial graph.
