# Root shared local PostgreSQL/Redis; Billing owns its database and logical DB 4.
DATABASE_URL=postgresql://kokoro:kokoro@127.0.0.1:55433/kokoro_worker_billing
POSTGRES_POOL_SIZE=10
REDIS_URL=redis://127.0.0.1:56380/4
REDIS_TEST_URL=redis://127.0.0.1:56380/4
REDIS_CONNECT_TIMEOUT_MS=2000
REDIS_READ_TIMEOUT_MS=1000
REDIS_OVERALL_TIMEOUT_MS=3000
BILLING_AUTH_MODE=internal-header
# Production: jwks (RS256 only); local development: internal-header only.
BILLING_AUTH_JWKS_URL=http://127.0.0.1:4211/.well-known/jwks.json
BILLING_AUTH_JWT_ISSUER=kokoro-iam
# Optional audience check; omit when the IAM session contract has no aud claim.
# BILLING_AUTH_JWT_AUDIENCE=kokoro-billing
BILLING_PORT=4245
BILLING_HOST=127.0.0.1
BILLING_SHUTDOWN_DEADLINE_MS=10000
LOG_LEVEL=info
INTERNAL_SERVICE_SECRET=TOKEN
BILLING_BFF_SERVICE_TOKEN=TOKEN
BILLING_OPERATOR_PROXY_SECRET=OPERATOR_PROXY_TOKEN
BILLING_REDEEM_SECRET=REPLACE_WITH_32_PLUS_BYTE_SECRET
PROVIDER_WEBHOOK_SECRETS_JSON='{"stripe":"TOKEN"}'
BILLING_ENABLED_PROVIDERS=stripe
BILLING_OUTBOX_MAX_ATTEMPTS=10
BILLING_WORKER_METRICS_HOST=127.0.0.1
BILLING_WORKER_METRICS_PORT=9095
BILLING_EXPIRY_METRICS_HOST=127.0.0.1
BILLING_EXPIRY_METRICS_PORT=9096
# Optional tenant scope for the scheduler-triggered expiry command; storage translation remains internal.
# BILLING_TENANT_ID=tenant-1
# BILLING_EXPIRY_LIMIT=100
# WeChat APIv3 AES-256-GCM resource key; platform certificate remains in PROVIDER_WEBHOOK_SECRETS_JSON.
WECHAT_API_V3_KEY=32_BYTE_API_V3_KEY
STRIPE_SECRET_KEY=sk_test_TOKEN
STRIPE_CONNECT_TIMEOUT_MS=3000
STRIPE_READ_TIMEOUT_MS=10000
STRIPE_OVERALL_TIMEOUT_MS=12000
# Required for a direct provider webhook endpoint when the signed event omits its account reference.
# BILLING_PROVIDER_ACCOUNT_REF_STRIPE=acct_TARGET
# BILLING_PROVIDER_ACCOUNT_REF_ALIPAY=APP_ID
# BILLING_PROVIDER_ACCOUNT_REF_WECHAT=MCH_ID
BILLING_PUBLIC_BASE_URL=http://127.0.0.1:3000
