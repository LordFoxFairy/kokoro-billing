# Root shared local PostgreSQL/Redis; Billing owns exactly kokoro_billing and logical DB 4.
DATABASE_URL=postgresql://USER:TOKEN@127.0.0.1:5432/kokoro?schema=kokoro_billing
POSTGRES_POOL_SIZE=10
REDIS_URL=redis://127.0.0.1:6379/4
REDIS_TEST_URL=redis://127.0.0.1:6379/4
REDIS_CONNECT_TIMEOUT_MS=2000
REDIS_READ_TIMEOUT_MS=1000
REDIS_OVERALL_TIMEOUT_MS=3000
BILLING_AUTH_MODE=jwks
# Normal local development uses IAM EdDSA JWKS and its exact issuer/resource profile.
BILLING_AUTH_JWKS_URL=http://127.0.0.1:3310/iam/jwks
BILLING_AUTH_JWT_ISSUER=http://127.0.0.1:3310/iam
BILLING_AUTH_JWT_AUDIENCE=https://kokoro.dev/resources/billing
BILLING_PORT=4245
BILLING_HOST=127.0.0.1
BILLING_SHUTDOWN_DEADLINE_MS=10000
LOG_LEVEL=info
INTERNAL_SERVICE_SECRET=REPLACE_WITH_DISTINCT_32_PLUS_PRINTABLE_SECRET_A
BILLING_BFF_SERVICE_TOKEN=REPLACE_WITH_DISTINCT_32_PLUS_PRINTABLE_SECRET_B
BILLING_OPERATOR_PROXY_SECRET=REPLACE_WITH_DISTINCT_32_PLUS_PRINTABLE_SECRET_C
BILLING_REDEEM_SECRET=REPLACE_WITH_32_PLUS_BYTE_SECRET
PROVIDER_WEBHOOK_SECRETS_JSON='{}'
BILLING_ENABLED_PROVIDERS=
BILLING_OUTBOX_MAX_ATTEMPTS=10
BILLING_WORKER_METRICS_HOST=127.0.0.1
BILLING_WORKER_METRICS_PORT=9095
BILLING_EXPIRY_METRICS_HOST=127.0.0.1
BILLING_EXPIRY_METRICS_PORT=9096
# Required tenant scope for the expiry worker.
BILLING_TENANT_ID=tenant-1
# Optional only for a one-shot retry; daemon mode rejects a fixed batch identity.
# BILLING_EXPIRY_BATCH_ID=expiry-batch-TARGET
# BILLING_EXPIRY_LIMIT=100
# WeChat APIv3 AES-256-GCM resource key; platform certificate remains in PROVIDER_WEBHOOK_SECRETS_JSON.
WECHAT_API_V3_KEY=32_BYTE_API_V3_KEY
# Payment providers are post-Billing-startup opt-ins.
# STRIPE_SECRET_KEY=sk_test_TOKEN
STRIPE_CONNECT_TIMEOUT_MS=3000
STRIPE_READ_TIMEOUT_MS=10000
STRIPE_OVERALL_TIMEOUT_MS=12000
# Required for a direct provider webhook endpoint when the signed event omits its account reference.
# BILLING_PROVIDER_ACCOUNT_REF_STRIPE=acct_TARGET
# BILLING_PROVIDER_ACCOUNT_REF_ALIPAY=APP_ID
# BILLING_PROVIDER_ACCOUNT_REF_WECHAT=MCH_ID
BILLING_PUBLIC_BASE_URL=http://127.0.0.1:3000
