{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_version",
    "completed",
    "failed_or_cancelled",
    "not_dispatched",
    "unknown_or_incomplete"
  ],
  "properties": {
    "artifact_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "completed": {
      "type": "string",
      "const": "capture_verified_actual_only"
    },
    "failed_or_cancelled": {
      "type": "string",
      "const": "capture_verified_actual_only"
    },
    "not_dispatched": {
      "type": "string",
      "const": "release_confirmed_unused"
    },
    "unknown_or_incomplete": {
      "type": "string",
      "const": "pending_reconciliation"
    }
  }
}
